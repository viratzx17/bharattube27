# ─────────────────────────────────────────────────────────────────────
# BharatTube — environment variables (NAMES ONLY, no secrets)
# ─────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in values. Never commit real secrets.

# REQUIRED — the existing deployed backend API base URL.
NEXT_PUBLIC_API_URL=https://bharattube-ylmq.onrender.com/api/v1

# NOT USED BY THE FRONTEND. The app reads all data from the backend above.
# Only relevant if you run the optional local PostgreSQL tooling.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Backend-side secrets live on the BACKEND (Render), never here:
#   MONGO_URI, JWT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
#   GOOGLE_CALLBACK_URL, CLIENT_URL, CLOUDINARY_* etc.
